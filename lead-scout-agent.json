    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Pega o texto da IA com segurança\nlet rawText = '';\nif ($json.output && $json.output[0] && $json.output[0].content) {\n  rawText = $json.output[0].content[0].text;\n} else if ($json.content && $json.content[0]) {\n  rawText = $json.content[0].text;\n} else {\n  rawText = JSON.stringify($json);\n}\n\n// 2. Remove possíveis marcações de markdown e converte para JSON\nconst cleanJson = rawText.replace(/```json/gi, '').replace(/```/gi, '').trim();\nlet dadosIa = {};\n\ntry {\n  dadosIa = JSON.parse(cleanJson);\n} catch (e) {\n  dadosIa = {\n    score: 5,\n    justificativa: \"Presença digital identificada\",\n    servico_recomendado: \"Site Moderno ou Chatbot\",\n    abordagem: \"Olá! Gostaria de conversar sobre soluções digitais para o seu negócio.\"\n  };\n}\n\n// 3. Junta com os dados da empresa que vieram da busca\nconst lead = $('Split Out').item.json;\n\nreturn {\n  nome: lead.title || \"Não informado\",\n  site: lead.url || \"Não informado\",\n  nicho: \"Academia\",\n  cidade: \"Recife\",\n  score: dadosIa.score || 0,\n  justificativa: dadosIa.justificativa || \"\",\n  servico: dadosIa.servico_recomendado || \"\",\n  abordagem: dadosIa.abordagem || \"\",\n  status: \"Novo\"\n};"
      },
